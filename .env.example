OPENAI_API_KEY=put link here
DEFAULT_AI_PROVIDER=openai
OPENAI_COMPLETION_MODEL=gpt-3.5-turbo
OPENAI_JSON_MODEL=gpt-4o-mini
AGENTROUTER_API_KEY=your_agentrouter_api_key_here
AGENTROUTER_BASE_URL=https://agentrouter.org/v1
AGENTROUTER_MODEL=claude-opus-4-6
GOOGLE_APPLICATION_CREDENTIALS=path/to/google-cloud-vision-credentials.json
ENVIRONMENT=development
API_PORT=8000
REDIS_URL=redis://localhost:6379
MAX_TOKENS=2000
TEMPERATURE=0.7

# Stock Photo APIs (for Visual Director Agent - Phase 2)
UNSPLASH_API_KEY=your_unsplash_access_key_here
PEXELS_API_KEY=your_pexels_api_key_here

# Qdrant Vector Database (for RAG - Phase 4)
QDRANT_HOST=localhost
QDRANT_PORT=6333

# Optional: DALL-E 3 for custom illustrations (Premium feature)
ENABLE_DALLE=false
